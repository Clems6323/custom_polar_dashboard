# Normalise line endings to LF in the repository; checkout as-is on all platforms
* text=auto eol=lf

# Force LF for files that must not have CRLF (shell scripts, Makefile, Dockerfile)
Makefile text eol=lf
Dockerfile text eol=lf
*.sh text eol=lf

# Binary files — no line-ending conversion
*.parquet binary
*.duckdb binary
*.png binary
*.jpg binary
*.ico binary
