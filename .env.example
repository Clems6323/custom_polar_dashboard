# =============================================================================
# Polar AccessLink — OAuth2 credentials
# Register at: https://admin.polaraccesslink.com
# =============================================================================
POLAR_CLIENT_ID=your-client-id-here
POLAR_CLIENT_SECRET=your-client-secret-here
POLAR_REDIRECT_URI=http://localhost:8000/auth/polar/callback

# =============================================================================
# Storage paths (defaults are relative to project root)
# =============================================================================
STORAGE_DATA_DIR=data
STORAGE_DUCKDB_PATH=data/polar_dashboard.duckdb
STORAGE_PARQUET_DIR=data/parquet
STORAGE_TOKEN_PATH=data/tokens/polar_token.json

# =============================================================================
# Application behaviour
# =============================================================================
APP_DEBUG=false
APP_LOG_LEVEL=INFO

# Set to true to populate the dashboard with synthetic data
# (useful when no Polar sync has been run yet)
APP_DEMO_MODE=false

# =============================================================================
# n8n — workflow automation / Telegram bridge
# Protect the n8n web UI with basic auth (change before exposing publicly)
# =============================================================================
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme

# Public HTTPS URL exposed by the Cloudflare Tunnel — must match the hostname
# you configure in the Cloudflare Zero Trust dashboard (Networks > Tunnels).
# n8n uses this to build the webhook URLs it shows in the editor.
# Example: https://n8n.yourdomain.com
N8N_WEBHOOK_URL=https://your-tunnel-hostname-here

# Token generated by Cloudflare when you create the tunnel.
# Zero Trust dashboard → Networks → Tunnels → Create tunnel → copy the token.
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token-here
